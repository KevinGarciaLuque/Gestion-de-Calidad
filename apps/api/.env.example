# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL="mysql://calidad360:CAMBIA_ESTA_CLAVE@localhost:3306/calidad360"

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS="http://localhost:5173"

# ── Autenticación (JWT) ─────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="cambia-esto-en-produccion-access"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="cambia-esto-en-produccion-refresh"
JWT_REFRESH_TTL="7d"
# Cookie del refresh token
REFRESH_COOKIE_NAME="c360_rt"
COOKIE_SECURE=false

# ── Archivos de documentos ─────────────────────────────────────────────────
ARCHIVOS_DIR="storage/documentos"
ARCHIVO_MAX_BYTES=26214400

# ── Super administrador inicial (usado por el seed) ─────────────────────────
SEED_ADMIN_EMAIL="admin@calidad360.local"
SEED_ADMIN_PASSWORD="Admin.123456"
SEED_ADMIN_NOMBRE="Super Administrador"

# ── Correo (opcional; sin SMTP_HOST el envío queda desactivado) ─────────────
# SMTP_HOST="smtp.tu-proveedor.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Calidad 360 <no-reply@tu-hospital.org>"

# ── Respaldos automáticos de la base de datos ────────────────────────────────
# BACKUPS_DIR="storage/backups"
# BACKUPS_RETENER=14

# ── Monitoreo de errores (opcional; sin SENTRY_DSN queda desactivado) ───────
# Crea un proyecto gratuito en https://sentry.io (tipo Node/NestJS) y pega su DSN.
# SENTRY_DSN="https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX"

# ────────────────────────────────────────────────────────────────────────────
#  En producción (Railway) cambian estos valores. Ver DEPLOY.md:
#    NODE_ENV=production
#    COOKIE_SECURE=true          # obliga SameSite=None + Secure en la cookie
#    DATABASE_URL=${{MySQL.MYSQL_URL}}
#    CORS_ORIGINS=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
#    ARCHIVOS_DIR=/data/archivos # carpeta montada en un Volume persistente
#    JWT_ACCESS_SECRET / JWT_REFRESH_SECRET  -> secretos largos y aleatorios
# ────────────────────────────────────────────────────────────────────────────
