// Calidad 360 Hospitalaria — esquema de datos
// Fase 0: identidad mínima + bitácora (auditoría append-only).
// Fase 1: roles, permisos, alcance, estructura organizacional y refresh tokens.
// Fase 2: mapa de procesos, fichas versionadas y relaciones entre procesos.
// Fase 3: indicadores / KPI y sus mediciones por periodo.
// Fase 4: matriz configurable, riesgos y oportunidades por proceso, revisiones.
// Fase 5: control documental — documentos versionados, archivos y lista maestra.
// Fase 6: auditorías — programa anual, planes, checklist, hallazgos e informe.
// Fase 7: hallazgos — análisis de causa, máquina de estados y verificación de eficacia.
// Fase 8: planes de mejora, acciones (CAPA) y registro de mejora continua (MCC).
// Fase 9: motor de automatizaciones, notificaciones y calendario transversal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Identidad y acceso
// ─────────────────────────────────────────────────────────────────────────────

/// Usuarios del sistema.
model Usuario {
  id                  String    @id @default(uuid())
  email               String    @unique
  nombre              String
  passwordHash        String    @map("password_hash")
  activo              Boolean   @default(true)
  debeCambiarPassword Boolean   @default(false) @map("debe_cambiar_password")
  ultimoAccesoAt      DateTime? @map("ultimo_acceso_at")
  intentosFallidos    Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta      DateTime? @map("bloqueado_hasta")
  creadoAt            DateTime  @default(now()) @map("creado_at")
  actualizadoAt       DateTime  @updatedAt @map("actualizado_at")

  roles               UsuarioRol[]
  refreshTokens       RefreshToken[]
  unidadesResponsable UnidadOrganizativa[] @relation("UnidadResponsable")
  eventos             Bitacora[]           @relation("BitacoraActor")
  procesosResponsable Proceso[]            @relation("ProcesoResponsable")
  procesosSuplente    Proceso[]            @relation("ProcesoSuplente")
  versionesProceso    ProcesoVersion[]     @relation("ProcesoVersionAutoria")
  indicadoresCaptura  Indicador[]          @relation("IndicadorResponsableCaptura")
  indicadoresAnalisis Indicador[]          @relation("IndicadorResponsableAnalisis")
  medicionesCapturadas MedicionIndicador[] @relation("MedicionCapturaPor")
  medicionesAnalizadas MedicionIndicador[] @relation("MedicionAnalisisPor")
  riesgosResponsable  Riesgo[]             @relation("RiesgoResponsable")
  revisionesRiesgo    RevisionRiesgo[]     @relation("RevisionRiesgoPor")
  documentosPropietario Documento[]        @relation("DocumentoPropietario")
  versionesDocPropuestas DocumentoVersion[] @relation("DocVersionPropuestaPor")
  versionesDocRevisor    DocumentoVersion[] @relation("DocVersionRevisor")
  versionesDocAprobador  DocumentoVersion[] @relation("DocVersionAprobador")
  archivosSubidos     ArchivoDocumento[]  @relation("ArchivoSubidoPor")
  auditoriasLider    Auditoria[]         @relation("AuditoriaLider")
  auditoriasEquipo   AuditoriaAuditor[]
  hallazgosDetectados Hallazgo[]         @relation("HallazgoDetectadoPor")
  hallazgosResponsable Hallazgo[]        @relation("HallazgoResponsable")
  evidenciasSubidas  Evidencia[]        @relation("EvidenciaSubidaPor")
  accionesResponsable Accion[]          @relation("AccionResponsable")
  accionesColaborador AccionColaborador[]
  accionesVerificadas Accion[]          @relation("AccionVerificadaPor")
  avancesAccion      AvanceAccion[]     @relation("AvanceAccionPor")
  mccPropuestos     RegistroMCC[]       @relation("MCCPropuestoPor")
  mccGestionados    RegistroMCC[]       @relation("MCCGestionadoPor")
  notificaciones    Notificacion[]

  @@map("usuarios")
}

/// Catálogo de roles. Los de sistema no se pueden eliminar.
model Rol {
  codigo      String  @id
  nombre      String
  descripcion String? @db.Text
  esSistema   Boolean @default(false) @map("es_sistema")
  activo      Boolean @default(true)
  orden       Int     @default(0)

  permisos   RolPermiso[]
  asignados  UsuarioRol[]

  @@map("roles")
}

/// Catálogo de permisos (acción sobre un módulo), p. ej. "usuarios.crear".
model Permiso {
  codigo      String  @id
  modulo      String
  descripcion String
  orden       Int     @default(0)

  roles RolPermiso[]

  @@index([modulo])
  @@map("permisos")
}

/// Relación rol ↔ permiso.
model RolPermiso {
  rolCodigo     String  @map("rol_codigo")
  permisoCodigo String  @map("permiso_codigo")

  rol     Rol     @relation(fields: [rolCodigo], references: [codigo], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoCodigo], references: [codigo], onDelete: Cascade)

  @@id([rolCodigo, permisoCodigo])
  @@map("roles_permisos")
}

enum TipoAlcance {
  GLOBAL
  UNIDAD
  PROCESO
}

/// Asignación de un rol a un usuario, con su alcance (global, una unidad, o
/// —desde la Fase 2— un proceso). Puede tener fecha de expiración (auditor externo).
model UsuarioRol {
  id          String      @id @default(uuid())
  usuarioId   String      @map("usuario_id")
  rolCodigo   String      @map("rol_codigo")
  tipoAlcance TipoAlcance @default(GLOBAL) @map("tipo_alcance")
  unidadId    String?     @map("unidad_id")
  procesoId   String?     @map("proceso_id")
  expiraAt    DateTime?   @map("expira_at")
  creadoAt    DateTime    @default(now()) @map("creado_at")

  usuario Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol                 @relation(fields: [rolCodigo], references: [codigo], onDelete: Cascade)
  unidad  UnidadOrganizativa? @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  proceso Proceso?            @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolCodigo, tipoAlcance, unidadId, procesoId])
  @@index([usuarioId])
  @@map("usuarios_roles")
}

/// Refresh tokens (hasheados). Se rotan en cada uso; `familia` permite
/// detectar reutilización de un token ya rotado y revocar toda la cadena.
model RefreshToken {
  id            String    @id @default(uuid())
  usuarioId     String    @map("usuario_id")
  tokenHash     String    @unique @map("token_hash")
  familia       String
  expiraAt      DateTime  @map("expira_at")
  revocadoAt    DateTime? @map("revocado_at")
  reemplazadoPor String?  @map("reemplazado_por")
  userAgent     String?   @map("user_agent")
  ip            String?
  creadoAt      DateTime  @default(now()) @map("creado_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familia])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Estructura organizacional
// ─────────────────────────────────────────────────────────────────────────────

enum TipoUnidad {
  HOSPITAL
  DIRECCION
  SUBDIRECCION
  DEPARTAMENTO
  SERVICIO
  AREA
}

/// Árbol de la organización: hospital/sede → direcciones → departamentos/servicios → áreas.
model UnidadOrganizativa {
  id            String     @id @default(uuid())
  codigo        String     @unique
  nombre        String
  tipo          TipoUnidad
  padreId       String?    @map("padre_id")
  responsableId String?    @map("responsable_id")
  activo        Boolean    @default(true)
  orden         Int        @default(0)
  creadoAt      DateTime   @default(now()) @map("creado_at")
  actualizadoAt DateTime   @updatedAt @map("actualizado_at")

  padre       UnidadOrganizativa?  @relation("Jerarquia", fields: [padreId], references: [id])
  hijos       UnidadOrganizativa[] @relation("Jerarquia")
  responsable Usuario?             @relation("UnidadResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  rolesAlcance UsuarioRol[]
  procesos    Proceso[]
  documentos  Documento[]
  auditorias  Auditoria[]
  hallazgos   Hallazgo[]
  registrosMCC RegistroMCC[]

  @@index([padreId])
  @@map("unidades_organizativas")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Procesos (Fase 2)
// ─────────────────────────────────────────────────────────────────────────────

enum TipoProceso {
  ESTRATEGICO
  MISIONAL
  APOYO
}

enum EstadoProceso {
  BORRADOR
  VIGENTE
  ARCHIVADO
}

enum EstadoVersionProceso {
  BORRADOR
  EN_REVISION
  APROBADA
  OBSOLETA
}

enum TipoRelacionProceso {
  PROVEEDOR
  CLIENTE
}

/// Proceso del SGC. Los datos de la "ficha de caracterización" viven en las
/// versiones (ProcesoVersion) para conservar el historial completo.
model Proceso {
  id                  String        @id @default(uuid())
  codigo              String        @unique
  nombre              String
  tipo                TipoProceso
  objetivo            String        @db.Text
  areaId              String?       @map("area_id")
  responsableId       String?       @map("responsable_id")
  suplenteId          String?       @map("suplente_id")
  estado              EstadoProceso @default(BORRADOR)
  ultimaAprobacionAt  DateTime?     @map("ultima_aprobacion_at")
  proximaRevisionAt   DateTime?     @map("proxima_revision_at")
  archivadoAt         DateTime?     @map("archivado_at")
  creadoAt            DateTime      @default(now()) @map("creado_at")
  actualizadoAt       DateTime      @updatedAt @map("actualizado_at")

  area        UnidadOrganizativa? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  responsable Usuario?            @relation("ProcesoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  suplente    Usuario?            @relation("ProcesoSuplente", fields: [suplenteId], references: [id], onDelete: SetNull)

  versiones      ProcesoVersion[]
  relaciones     ProcesoRelacion[] @relation("ProcesoOrigen")
  relacionadoPor ProcesoRelacion[] @relation("ProcesoDestino")
  rolesAlcance   UsuarioRol[]
  indicadores    Indicador[]
  riesgos        Riesgo[]
  documentos     Documento[]
  auditorias     Auditoria[]
  auditoriaItems AuditoriaItem[]
  hallazgos      Hallazgo[]
  acciones       Accion[]

  @@index([tipo])
  @@index([areaId])
  @@map("procesos")
}

/// Una versión de la ficha de caracterización de un proceso.
model ProcesoVersion {
  id         String               @id @default(uuid())
  procesoId  String               @map("proceso_id")
  numero     Int
  estado     EstadoVersionProceso @default(BORRADOR)

  // Contenido de la ficha
  alcance     String  @db.Text
  entradas    Json    @default("[]") // [{ proveedor, insumo, requisitos }]
  actividades Json    @default("[]") // [{ orden, actividad, responsable, puntoControl }]
  salidas     Json    @default("[]") // [{ salida, registro, cliente }]
  recursos    Json    @default("[]") // [{ tipo, detalle }]
  notas       String? @db.Text

  // Trazabilidad del flujo de aprobación
  propuestaPorId String?   @map("propuesta_por_id")
  revisadaPorId  String?   @map("revisada_por_id")
  aprobadaPorId  String?   @map("aprobada_por_id")
  enviadaRevisionAt DateTime? @map("enviada_revision_at")
  aprobadaAt     DateTime? @map("aprobada_at")
  comentarioRevision String? @map("comentario_revision") @db.Text

  creadoAt      DateTime @default(now()) @map("creado_at")
  actualizadoAt DateTime @updatedAt @map("actualizado_at")

  proceso     Proceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  propuestaPor Usuario? @relation("ProcesoVersionAutoria", fields: [propuestaPorId], references: [id], onDelete: SetNull)

  @@unique([procesoId, numero])
  @@index([procesoId, estado])
  @@map("procesos_versiones")
}

/// Relación proveedor/cliente interno entre dos procesos (handoff).
model ProcesoRelacion {
  id          String              @id @default(uuid())
  origenId    String              @map("origen_id")
  destinoId   String              @map("destino_id")
  tipo        TipoRelacionProceso
  descripcion String?             @db.Text
  creadoAt    DateTime            @default(now()) @map("creado_at")

  origen  Proceso @relation("ProcesoOrigen", fields: [origenId], references: [id], onDelete: Cascade)
  destino Proceso @relation("ProcesoDestino", fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([origenId, destinoId, tipo])
  @@index([destinoId])
  @@map("procesos_relaciones")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Indicadores / KPI (Fase 3)
// ─────────────────────────────────────────────────────────────────────────────

enum FrecuenciaIndicador {
  MENSUAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// Sentido de mejora: CRECIENTE = un valor más alto es mejor.
enum SentidoIndicador {
  CRECIENTE
  DECRECIENTE
}

enum SemaforoMedicion {
  VERDE
  AMARILLO
  ROJO
}

model Indicador {
  id                    String              @id @default(uuid())
  codigo                String              @unique
  nombre                String
  objetivo              String              @db.Text
  procesoId             String              @map("proceso_id")
  formula               String              @db.Text
  usaNumeradorDenominador Boolean           @default(true) @map("usa_num_den")
  expresarPorcentaje    Boolean             @default(true) @map("expresar_porcentaje")
  unidad                String
  fuenteDatos           String?             @map("fuente_datos") @db.Text
  frecuencia            FrecuenciaIndicador
  sentido               SentidoIndicador    @default(CRECIENTE)
  meta                  Float
  umbralAmarillo        Float?              @map("umbral_amarillo")
  responsableCapturaId  String?             @map("responsable_captura_id")
  responsableAnalisisId String?             @map("responsable_analisis_id")
  activo                Boolean             @default(true)
  archivadoAt           DateTime?           @map("archivado_at")
  creadoAt              DateTime            @default(now()) @map("creado_at")
  actualizadoAt         DateTime            @updatedAt @map("actualizado_at")

  proceso              Proceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  responsableCaptura   Usuario? @relation("IndicadorResponsableCaptura", fields: [responsableCapturaId], references: [id], onDelete: SetNull)
  responsableAnalisis  Usuario? @relation("IndicadorResponsableAnalisis", fields: [responsableAnalisisId], references: [id], onDelete: SetNull)
  mediciones           MedicionIndicador[]

  @@index([procesoId])
  @@map("indicadores")
}

/// Resultado del indicador para un periodo concreto.
model MedicionIndicador {
  id           String           @id @default(uuid())
  indicadorId  String           @map("indicador_id")
  anio         Int
  periodo      Int // 1..12 (mensual), 1..4 (trimestral), etc.
  etiqueta     String
  numerador    Float?
  denominador  Float?
  valor        Float
  semaforo     SemaforoMedicion
  analisis     String?          @db.Text
  planAccion   String?          @map("plan_accion") @db.Text
  evidenciaUrl String?          @map("evidencia_url")
  capturadoPorId String?        @map("capturado_por_id")
  capturadoAt   DateTime        @default(now()) @map("capturado_at")
  analizadoPorId String?        @map("analizado_por_id")
  analizadoAt   DateTime?       @map("analizado_at")
  actualizadoAt DateTime        @updatedAt @map("actualizado_at")

  indicador    Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  capturadoPor Usuario?  @relation("MedicionCapturaPor", fields: [capturadoPorId], references: [id], onDelete: SetNull)
  analizadoPor Usuario?  @relation("MedicionAnalisisPor", fields: [analizadoPorId], references: [id], onDelete: SetNull)
  acciones     Accion[]

  @@unique([indicadorId, anio, periodo])
  @@index([indicadorId])
  @@map("mediciones_indicador")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Riesgos y oportunidades (Fase 4)
// ─────────────────────────────────────────────────────────────────────────────

enum TipoRiesgo {
  RIESGO
  OPORTUNIDAD
}

enum CategoriaRiesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EficaciaControl {
  NO_EVALUADA
  INEFICAZ
  PARCIAL
  EFICAZ
}

enum EstadoRiesgo {
  IDENTIFICADO
  EN_TRATAMIENTO
  MONITOREADO
  CERRADO
  MATERIALIZADO
}

/// Configuración única de la matriz de evaluación. Editable por Calidad.
model MatrizRiesgo {
  id                  Int    @id @default(1)
  escalaProbabilidad  Json // [{ valor, etiqueta, descripcion? }]
  escalaImpacto       Json
  umbralMedio         Int // nivel (prob×impacto) a partir del cual es MEDIO
  umbralAlto          Int
  umbralCritico       Int
  mesesRevisionDefault Int   @default(12) @map("meses_revision_default")
  actualizadoAt       DateTime @updatedAt @map("actualizado_at")

  @@map("matriz_riesgo")
}

model Riesgo {
  id            String          @id @default(uuid())
  codigo        String          @unique
  tipo          TipoRiesgo      @default(RIESGO)
  procesoId     String          @map("proceso_id")
  descripcion   String          @db.Text
  causa         String?         @db.Text
  consecuencia  String?         @db.Text

  // Evaluación inherente
  probabilidadInherente Int     @map("probabilidad_inherente")
  impactoInherente      Int     @map("impacto_inherente")
  nivelInherente        Int     @map("nivel_inherente")
  categoriaInherente    CategoriaRiesgo @map("categoria_inherente")

  // Controles y tratamiento
  controles       String?        @db.Text
  eficaciaControl EficaciaControl @default(NO_EVALUADA) @map("eficacia_control")
  planTratamiento String?        @map("plan_tratamiento") @db.Text
  responsableId   String?        @map("responsable_id")
  fechaCompromiso DateTime?      @map("fecha_compromiso")

  // Evaluación residual
  probabilidadResidual Int?      @map("probabilidad_residual")
  impactoResidual      Int?      @map("impacto_residual")
  nivelResidual        Int?      @map("nivel_residual")
  categoriaResidual    CategoriaRiesgo? @map("categoria_residual")

  estado             EstadoRiesgo @default(IDENTIFICADO)
  fechaRevision      DateTime?    @map("fecha_revision")
  ultimaRevisionAt   DateTime?    @map("ultima_revision_at")
  requiereReevaluacion Boolean    @default(false) @map("requiere_reevaluacion")
  archivadoAt        DateTime?    @map("archivado_at")
  creadoAt           DateTime     @default(now()) @map("creado_at")
  actualizadoAt      DateTime     @updatedAt @map("actualizado_at")

  proceso     Proceso  @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  responsable Usuario? @relation("RiesgoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  revisiones  RevisionRiesgo[]
  acciones    Accion[]

  @@index([procesoId])
  @@index([tipo])
  @@map("riesgos")
}

/// Registro de cada revisión / reevaluación del riesgo.
model RevisionRiesgo {
  id          String   @id @default(uuid())
  riesgoId    String   @map("riesgo_id")
  fecha       DateTime @default(now())
  revisadoPorId String? @map("revisado_por_id")
  comentario  String?  @db.Text
  // Snapshot tras la revisión
  probabilidad Int?
  impacto      Int?
  nivel        Int?
  categoria    CategoriaRiesgo?
  esResidual   Boolean @default(true) @map("es_residual")

  riesgo      Riesgo   @relation(fields: [riesgoId], references: [id], onDelete: Cascade)
  revisadoPor Usuario? @relation("RevisionRiesgoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@index([riesgoId])
  @@map("revisiones_riesgo")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Control documental (Fase 5)
// ─────────────────────────────────────────────────────────────────────────────

enum TipoDocumento {
  POLITICA
  MANUAL
  PROCEDIMIENTO
  PROTOCOLO
  INSTRUCTIVO
  FORMATO
  REGISTRO
  GUIA
  LISTA_MAESTRA
  EXTERNO
}

enum EstadoVersionDocumento {
  BORRADOR
  EN_REVISION
  VIGENTE
  OBSOLETA
}

/// Archivo cargado (una versión de documento apunta a uno).
model ArchivoDocumento {
  id            String   @id @default(uuid())
  nombreOriginal String  @map("nombre_original")
  rutaRelativa  String   @map("ruta_relativa")
  mimeType      String   @map("mime_type")
  tamanoBytes   Int      @map("tamano_bytes")
  hashSha256    String   @map("hash_sha256")
  subidoPorId   String?  @map("subido_por_id")
  subidoAt      DateTime @default(now()) @map("subido_at")

  subidoPor Usuario?           @relation("ArchivoSubidoPor", fields: [subidoPorId], references: [id], onDelete: SetNull)
  versiones DocumentoVersion[]

  @@map("archivos_documento")
}

model Documento {
  id            String        @id @default(uuid())
  codigo        String        @unique
  nombre        String
  tipo          TipoDocumento
  procesoId     String?       @map("proceso_id")
  areaId        String?       @map("area_id")
  propietarioId String?       @map("propietario_id")
  restringido   Boolean       @default(false)
  palabrasClave String?       @map("palabras_clave") @db.Text
  archivadoAt   DateTime?     @map("archivado_at")
  creadoAt      DateTime      @default(now()) @map("creado_at")
  actualizadoAt DateTime      @updatedAt @map("actualizado_at")

  proceso     Proceso?            @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  area        UnidadOrganizativa? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  propietario Usuario?            @relation("DocumentoPropietario", fields: [propietarioId], references: [id], onDelete: SetNull)
  versiones   DocumentoVersion[]

  @@index([tipo])
  @@index([procesoId])
  @@map("documentos")
}

model DocumentoVersion {
  id                String                 @id @default(uuid())
  documentoId       String                 @map("documento_id")
  numero            Int
  estado            EstadoVersionDocumento  @default(BORRADOR)
  motivoCambio      String?                @map("motivo_cambio") @db.Text
  archivoId         String?                @map("archivo_id")
  fechaEmision      DateTime?              @map("fecha_emision")
  fechaVigenciaDesde DateTime?             @map("fecha_vigencia_desde")
  proximaRevisionAt DateTime?              @map("proxima_revision_at")

  propuestaPorId    String?                @map("propuesta_por_id")
  revisorId         String?                @map("revisor_id")
  aprobadorId       String?                @map("aprobador_id")
  enviadaRevisionAt DateTime?              @map("enviada_revision_at")
  aprobadaAt        DateTime?              @map("aprobada_at")
  comentarioRevision String?               @map("comentario_revision") @db.Text

  creadoAt          DateTime               @default(now()) @map("creado_at")
  actualizadoAt     DateTime               @updatedAt @map("actualizado_at")

  documento    Documento         @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  archivo      ArchivoDocumento? @relation(fields: [archivoId], references: [id], onDelete: SetNull)
  propuestaPor Usuario?          @relation("DocVersionPropuestaPor", fields: [propuestaPorId], references: [id], onDelete: SetNull)
  revisor      Usuario?          @relation("DocVersionRevisor", fields: [revisorId], references: [id], onDelete: SetNull)
  aprobador    Usuario?          @relation("DocVersionAprobador", fields: [aprobadorId], references: [id], onDelete: SetNull)

  @@unique([documentoId, numero])
  @@index([documentoId, estado])
  @@map("documentos_versiones")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Auditorías (Fase 6)
// ─────────────────────────────────────────────────────────────────────────────

enum EstadoPrograma {
  BORRADOR
  APROBADO
}

enum TipoAuditoria {
  INTERNA
  EXTERNA
  SEGUIMIENTO
}

enum EstadoAuditoria {
  PLANIFICADA
  EN_CURSO
  EJECUTADA
  INFORME_APROBADO
  CERRADA
  CANCELADA
}

enum ResultadoItem {
  PENDIENTE
  CUMPLE
  NO_CUMPLE
  OBSERVACION
  NO_APLICA
}

model ProgramaAuditoria {
  id           String         @id @default(uuid())
  anio         Int            @unique
  nombre       String
  objetivo     String?        @db.Text
  estado       EstadoPrograma @default(BORRADOR)
  aprobadoPorId String?       @map("aprobado_por_id")
  aprobadoAt   DateTime?      @map("aprobado_at")
  creadoAt     DateTime       @default(now()) @map("creado_at")
  actualizadoAt DateTime      @updatedAt @map("actualizado_at")

  auditorias Auditoria[]

  @@map("programas_auditoria")
}

model Auditoria {
  id              String          @id @default(uuid())
  codigo          String          @unique
  programaId      String?         @map("programa_id")
  tipo            TipoAuditoria   @default(INTERNA)
  procesoId       String?         @map("proceso_id")
  areaId          String?         @map("area_id")
  objetivo        String          @db.Text
  alcance         String          @db.Text
  criterios       String          @db.Text
  auditorLiderId  String?         @map("auditor_lider_id")
  fechaPlanificada DateTime       @map("fecha_planificada")
  fechaInicioReal DateTime?       @map("fecha_inicio_real")
  fechaFinReal    DateTime?       @map("fecha_fin_real")
  estado          EstadoAuditoria @default(PLANIFICADA)
  reprogramaciones Json           @default("[]") // [{ fechaAnterior, fechaNueva, motivo, fecha, porId }]
  informeResumen  String?         @map("informe_resumen") @db.Text
  informeConclusiones String?     @map("informe_conclusiones") @db.Text
  informeAprobadoPorId String?    @map("informe_aprobado_por_id")
  informeAprobadoAt DateTime?     @map("informe_aprobado_at")
  creadoAt        DateTime        @default(now()) @map("creado_at")
  actualizadoAt   DateTime        @updatedAt @map("actualizado_at")

  programa    ProgramaAuditoria?  @relation(fields: [programaId], references: [id], onDelete: SetNull)
  proceso     Proceso?            @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  area        UnidadOrganizativa? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  auditorLider Usuario?           @relation("AuditoriaLider", fields: [auditorLiderId], references: [id], onDelete: SetNull)
  equipo      AuditoriaAuditor[]
  items       AuditoriaItem[]
  hallazgos   Hallazgo[]

  @@index([programaId])
  @@index([procesoId])
  @@index([estado])
  @@map("auditorias")
}

model AuditoriaAuditor {
  auditoriaId String @map("auditoria_id")
  usuarioId   String @map("usuario_id")

  auditoria Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([auditoriaId, usuarioId])
  @@map("auditorias_auditores")
}

model AuditoriaItem {
  id          String        @id @default(uuid())
  auditoriaId String        @map("auditoria_id")
  orden       Int
  criterio    String        @db.Text
  procesoId   String?       @map("proceso_id")
  resultado   ResultadoItem @default(PENDIENTE)
  notas       String?       @db.Text
  creadoAt    DateTime      @default(now()) @map("creado_at")
  actualizadoAt DateTime    @updatedAt @map("actualizado_at")

  auditoria Auditoria  @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  proceso   Proceso?   @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  hallazgos Hallazgo[]

  @@index([auditoriaId])
  @@map("auditorias_items")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Hallazgos y no conformidades (Fase 6 base + Fase 7 ciclo completo)
// ─────────────────────────────────────────────────────────────────────────────

enum OrigenHallazgo {
  AUDITORIA
  INDICADOR
  QUEJA
  INCIDENTE
  INSPECCION
  REVISION_DIRECCION
  OTRO
}

enum ClasificacionHallazgo {
  NO_CONFORMIDAD_MAYOR
  NO_CONFORMIDAD_MENOR
  OBSERVACION
  OPORTUNIDAD_MEJORA
}

enum EstadoHallazgo {
  ABIERTO
  EN_ANALISIS
  PLAN_APROBADO
  EN_EJECUCION
  PENDIENTE_EFICACIA
  CERRADO
  REABIERTO
}

enum PrioridadHallazgo {
  BAJA
  MEDIA
  ALTA
}

enum MetodologiaCausa {
  CINCO_PORQUES
  ISHIKAWA
  LLUVIA_CAUSAS
  OTRO
}

model Hallazgo {
  id             String                @id @default(uuid())
  codigo         String                @unique
  origen         OrigenHallazgo
  auditoriaId    String?               @map("auditoria_id")
  auditoriaItemId String?              @unique @map("auditoria_item_id")
  procesoId      String?               @map("proceso_id")
  areaId         String?               @map("area_id")
  descripcion    String                @db.Text
  clasificacion  ClasificacionHallazgo
  requisito      String?
  evidencia      String?               @db.Text
  fechaDeteccion DateTime              @default(now()) @map("fecha_deteccion")
  detectadoPorId String?               @map("detectado_por_id")
  responsableId  String?               @map("responsable_id")
  fechaCompromiso DateTime?            @map("fecha_compromiso")
  prioridad      PrioridadHallazgo     @default(MEDIA)
  estado         EstadoHallazgo        @default(ABIERTO)

  // Fase 7 — ciclo completo
  correccionInmediata String?          @map("correccion_inmediata") @db.Text
  planAccion          String?          @map("plan_accion") @db.Text
  validadoPorId       String?          @map("validado_por_id")
  validadoAt          DateTime?        @map("validado_at")
  planAprobadoPorId   String?          @map("plan_aprobado_por_id")
  planAprobadoAt      DateTime?        @map("plan_aprobado_at")
  verificacionEficacia String?         @map("verificacion_eficacia") @db.Text
  eficaciaConfirmada Boolean?          @map("eficacia_confirmada")
  verificadoPorId    String?           @map("verificado_por_id")
  verificadoAt       DateTime?         @map("verificado_at")
  fechaCierre        DateTime?         @map("fecha_cierre")
  motivoReapertura  String?           @map("motivo_reapertura") @db.Text

  archivadoAt    DateTime?             @map("archivado_at")
  creadoAt       DateTime              @default(now()) @map("creado_at")
  actualizadoAt  DateTime              @updatedAt @map("actualizado_at")

  auditoria     Auditoria?     @relation(fields: [auditoriaId], references: [id], onDelete: SetNull)
  auditoriaItem AuditoriaItem? @relation(fields: [auditoriaItemId], references: [id], onDelete: SetNull)
  proceso       Proceso?       @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  area          UnidadOrganizativa? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  detectadoPor  Usuario?       @relation("HallazgoDetectadoPor", fields: [detectadoPorId], references: [id], onDelete: SetNull)
  responsable   Usuario?       @relation("HallazgoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  analisisCausa AnalisisCausa?
  eventos       EventoHallazgo[]
  acciones      Accion[]

  @@index([origen])
  @@index([estado])
  @@index([procesoId])
  @@map("hallazgos")
}

/// Análisis de causa raíz de un hallazgo (1:1).
model AnalisisCausa {
  id            String           @id @default(uuid())
  hallazgoId    String           @unique @map("hallazgo_id")
  metodologia   MetodologiaCausa
  contenido     Json             @default("{}") // estructura según la metodología
  causaInmediata String?         @map("causa_inmediata") @db.Text
  causaContribuyente String?     @map("causa_contribuyente") @db.Text
  causaRaiz     String?          @map("causa_raiz") @db.Text
  comentariosEquipo String?      @map("comentarios_equipo") @db.Text
  elaboradoPorId String?         @map("elaborado_por_id")
  elaboradoAt   DateTime?        @map("elaborado_at")
  actualizadoAt DateTime         @updatedAt @map("actualizado_at")

  hallazgo Hallazgo @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)

  @@map("analisis_causa")
}

/// Línea de tiempo del hallazgo: cada transición de estado / hito.
model EventoHallazgo {
  id         String   @id @default(uuid())
  hallazgoId String   @map("hallazgo_id")
  fecha      DateTime @default(now())
  tipo       String // "validado", "plan_aprobado", "en_ejecucion", "eficacia", "cerrado", "reabierto", "comentario"
  detalle    String?  @db.Text
  estadoNuevo EstadoHallazgo? @map("estado_nuevo")
  actorId    String?  @map("actor_id")
  actorNombre String? @map("actor_nombre")

  hallazgo Hallazgo @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)

  @@index([hallazgoId])
  @@map("eventos_hallazgo")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Evidencias (adjuntos polimórficos — reutilizable en varios módulos)
// ─────────────────────────────────────────────────────────────────────────────

model Evidencia {
  id            String   @id @default(uuid())
  entidad       String // "AuditoriaItem", "Hallazgo", ...
  entidadId     String   @map("entidad_id")
  nombreOriginal String  @map("nombre_original")
  rutaRelativa  String   @map("ruta_relativa")
  mimeType      String   @map("mime_type")
  tamanoBytes   Int      @map("tamano_bytes")
  hashSha256    String   @map("hash_sha256")
  descripcion   String?
  subidoPorId   String?  @map("subido_por_id")
  subidoAt      DateTime @default(now()) @map("subido_at")

  subidoPor Usuario? @relation("EvidenciaSubidaPor", fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@map("evidencias")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Bitácora
// ─────────────────────────────────────────────────────────────────────────────

/// Registro inmutable de acciones relevantes (quién, qué, cuándo, antes/después).
/// No se actualiza ni se borra: solo se inserta.
model Bitacora {
  id            BigInt   @id @default(autoincrement())
  fecha         DateTime @default(now())
  actorId       String?  @map("actor_id")
  actorEmail    String?  @map("actor_email")
  accion        String
  entidad       String?
  entidadId     String?  @map("entidad_id")
  valorAnterior Json?    @map("valor_anterior")
  valorNuevo    Json?    @map("valor_nuevo")
  ip            String?
  userAgent     String?  @map("user_agent")

  actor Usuario? @relation("BitacoraActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([actorId])
  @@index([entidad, entidadId])
  @@map("bitacora")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Acciones / CAPA (Fase 8)
// ─────────────────────────────────────────────────────────────────────────────

enum TipoAccion {
  CORRECCION
  ACCION_CORRECTIVA
  TRATAMIENTO_RIESGO
  MEJORA
}

enum OrigenAccion {
  HALLAZGO
  RIESGO
  INDICADOR
  AUDITORIA
  COMITE
  MCC
  OTRO
}

enum EstadoAccion {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  VERIFICADA
  CANCELADA
}

model Accion {
  id              String       @id @default(uuid())
  codigo          String       @unique
  tipo            TipoAccion
  descripcion     String       @db.Text
  resultadoEsperado String?    @map("resultado_esperado") @db.Text

  origen          OrigenAccion
  origenLibre     String?      @map("origen_libre")
  hallazgoId      String?      @map("hallazgo_id")
  riesgoId        String?      @map("riesgo_id")
  medicionId      String?      @map("medicion_id")
  procesoId       String?      @map("proceso_id")
  mccId           String?      @map("mcc_id")

  responsableId   String?      @map("responsable_id")
  fechaInicio     DateTime?    @map("fecha_inicio")
  fechaCompromiso DateTime?    @map("fecha_compromiso")
  prioridad       PrioridadHallazgo @default(MEDIA)
  evidenciaRequerida String?   @map("evidencia_requerida") @db.Text
  avance          Int          @default(0)
  estado          EstadoAccion @default(PENDIENTE)

  verificacionEficacia String? @map("verificacion_eficacia") @db.Text
  eficaz          Boolean?
  verificadoPorId String?      @map("verificado_por_id")
  verificadoAt    DateTime?    @map("verificado_at")
  fechaCierre     DateTime?    @map("fecha_cierre")
  archivadoAt     DateTime?    @map("archivado_at")
  creadoAt        DateTime     @default(now()) @map("creado_at")
  actualizadoAt   DateTime     @updatedAt @map("actualizado_at")

  hallazgo    Hallazgo?          @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)
  riesgo      Riesgo?            @relation(fields: [riesgoId], references: [id], onDelete: Cascade)
  medicion    MedicionIndicador? @relation(fields: [medicionId], references: [id], onDelete: SetNull)
  proceso     Proceso?           @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  mcc         RegistroMCC?       @relation(fields: [mccId], references: [id], onDelete: SetNull)
  responsable Usuario?           @relation("AccionResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  verificadoPor Usuario?         @relation("AccionVerificadaPor", fields: [verificadoPorId], references: [id], onDelete: SetNull)
  colaboradores AccionColaborador[]
  avances     AvanceAccion[]

  @@index([hallazgoId])
  @@index([riesgoId])
  @@index([estado])
  @@map("acciones")
}

model AccionColaborador {
  accionId  String @map("accion_id")
  usuarioId String @map("usuario_id")

  accion  Accion  @relation(fields: [accionId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([accionId, usuarioId])
  @@map("acciones_colaboradores")
}

/// Cada actualización de avance de una acción.
model AvanceAccion {
  id         String   @id @default(uuid())
  accionId   String   @map("accion_id")
  fecha      DateTime @default(now())
  avance     Int
  comentario String?  @db.Text
  estadoNuevo EstadoAccion? @map("estado_nuevo")
  porId      String?  @map("por_id")
  porNombre  String?  @map("por_nombre")

  accion Accion   @relation(fields: [accionId], references: [id], onDelete: Cascade)
  por    Usuario? @relation("AvanceAccionPor", fields: [porId], references: [id], onDelete: SetNull)

  @@index([accionId])
  @@map("avances_accion")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Registro de Mejora Continua de la Calidad — MCC (Fase 8)
// ─────────────────────────────────────────────────────────────────────────────

enum OrigenMCC {
  COLABORADOR
  AREA
  ENCUESTA
  INDICADOR
  AUDITORIA
  COMITE
  OTRO
}

enum EstadoMCC {
  NUEVO
  EN_REVISION
  ACEPTADO
  NO_PROCEDE
  EN_EJECUCION
  VERIFICACION
  CERRADO
}

model RegistroMCC {
  id            String    @id @default(uuid())
  codigo        String    @unique
  titulo        String
  descripcion   String    @db.Text
  origen        OrigenMCC
  origenDetalle String?   @map("origen_detalle")
  areaId        String?   @map("area_id")
  propuestoPorId String?  @map("propuesto_por_id")
  estado        EstadoMCC @default(NUEVO)

  // Clasificación de Calidad
  impacto       String?   // libre: alto/medio/bajo o texto
  prioridad     PrioridadHallazgo?
  clasificadoPorId String? @map("clasificado_por_id")
  decisionJustificacion String? @map("decision_justificacion") @db.Text
  evaluacionResultado String? @map("evaluacion_resultado") @db.Text
  aprendizaje   String?   @db.Text
  fechaCierre   DateTime? @map("fecha_cierre")
  archivadoAt   DateTime? @map("archivado_at")
  creadoAt      DateTime  @default(now()) @map("creado_at")
  actualizadoAt DateTime  @updatedAt @map("actualizado_at")

  area        UnidadOrganizativa? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  propuestoPor Usuario?           @relation("MCCPropuestoPor", fields: [propuestoPorId], references: [id], onDelete: SetNull)
  gestionadoPor Usuario?          @relation("MCCGestionadoPor", fields: [clasificadoPorId], references: [id], onDelete: SetNull)
  acciones    Accion[]
  eventos     EventoMCC[]

  @@index([estado])
  @@map("registros_mcc")
}

model EventoMCC {
  id       String   @id @default(uuid())
  mccId    String   @map("mcc_id")
  fecha    DateTime @default(now())
  tipo     String
  detalle  String?  @db.Text
  estadoNuevo EstadoMCC? @map("estado_nuevo")
  actorNombre String? @map("actor_nombre")

  mcc RegistroMCC @relation(fields: [mccId], references: [id], onDelete: Cascade)

  @@index([mccId])
  @@map("eventos_mcc")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Notificaciones y automatizaciones (Fase 9)
// ─────────────────────────────────────────────────────────────────────────────

enum NivelNotificacion {
  INFO
  AVISO
  URGENTE
}

model Notificacion {
  id         String            @id @default(uuid())
  usuarioId  String            @map("usuario_id")
  nivel      NivelNotificacion @default(AVISO)
  titulo     String
  mensaje    String            @db.Text
  entidad    String?
  entidadId  String?           @map("entidad_id")
  ruta       String?
  claveDedup String?           @map("clave_dedup")
  leidaAt    DateTime?         @map("leida_at")
  creadoAt   DateTime          @default(now()) @map("creado_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, claveDedup])
  @@index([usuarioId, leidaAt])
  @@map("notificaciones")
}

/// Reglas del motor de automatizaciones. Se siembran por defecto y las edita Calidad.
model ReglaAutomatizacion {
  codigo      String   @id
  nombre      String
  descripcion String   @db.Text
  activa      Boolean  @default(true)
  /// Config libre: { diasAviso: [30,15,7], escalamiento: [{dias:1,a:"responsable"},...], enviarCorreo: bool }
  config      Json     @default("{}")
  orden       Int      @default(0)
  actualizadoAt DateTime @updatedAt @map("actualizado_at")

  @@map("reglas_automatizacion")
}

/// Última ejecución del motor (para el panel de administración).
model EjecucionMotor {
  id            String   @id @default(uuid())
  inicio        DateTime @default(now())
  fin           DateTime?
  notificaciones Int     @default(0)
  detalle       Json     @default("{}")
  manual        Boolean  @default(false)

  @@map("ejecuciones_motor")
}
