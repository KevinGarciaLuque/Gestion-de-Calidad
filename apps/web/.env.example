# URL base de la API.
# En desarrollo se usa el proxy de Vite, basta con "/api".
VITE_API_URL="/api"

# En producción (Railway) apunta al dominio público de la API, incluido /api.
# Es una variable de BUILD: si la cambias hay que volver a desplegar el front.
#   VITE_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}/api

# Monitoreo de errores (opcional; sin esta variable Sentry queda desactivado).
# Crea un proyecto gratuito en https://sentry.io (tipo React) y pega su DSN.
# También es una variable de BUILD.
# VITE_SENTRY_DSN="https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX"
